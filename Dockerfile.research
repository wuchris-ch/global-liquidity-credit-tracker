FROM python:3.11.14-slim
WORKDIR /app
RUN pip install --no-cache-dir uv==0.9.16
COPY pyproject.toml uv.lock ./
COPY src ./src
COPY config ./config
COPY .python-version ./
RUN uv sync --locked --no-dev && useradd --create-home --uid 10001 research && mkdir -p /app/data/research && chown -R research:research /app/data
ENV PATH="/app/.venv/bin:$PATH" RESEARCH_DATA_PATH=/app/data/research RESEARCH_AUTH_MODE=oidc
USER research
EXPOSE 8000
CMD ["uvicorn", "src.research.api:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--no-proxy-headers"]
