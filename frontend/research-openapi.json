  "components": {
    "schemas": {
      "AssistantRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Question"
          },
          "run_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 2,
            "title": "Run Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question"
        ],
        "title": "AssistantRequest"
      },
      "ComparisonRequest": {
        "properties": {
          "left": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Left"
          },
          "right": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Right"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "left",
          "right"
        ],
        "title": "ComparisonRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IngestRequest": {
        "properties": {
          "series": {
            "$ref": "#/components/schemas/Series"
          },
          "scope": {
            "$ref": "#/components/schemas/Scope"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "series",
          "scope"
        ],
        "title": "IngestRequest"
      },
      "ModelRequest": {
        "properties": {
          "cutoff": {
            "type": "string",
            "format": "date",
            "title": "Cutoff"
          },
          "start": {
            "type": "string",
            "format": "date",
            "title": "Start"
          },
          "inputs": {
            "additionalProperties": {
              "$ref": "#/components/schemas/Query"
            },
            "type": "object",
            "maxProperties": 100,
            "minProperties": 1,
            "title": "Inputs"
          },
          "interpretation": {
            "type": "string",
            "title": "Interpretation",
            "default": "reconstruction"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "cutoff",
          "start",
          "inputs"
        ],
        "title": "ModelRequest"
      },
      "Note": {
        "properties": {
          "run_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Run Id"
          },
          "text": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "run_id",
          "text"
        ],
        "title": "Note"
      },
      "Outcome": {
        "properties": {
          "signal_date": {
            "type": "string",
            "format": "date",
            "title": "Signal Date"
          },
          "model_run_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Model Run Id"
          },
          "target": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Target"
          },
          "entry_date": {
            "type": "string",
            "format": "date",
            "title": "Entry Date"
          },
          "exit_date": {
            "type": "string",
            "format": "date",
            "title": "Exit Date"
          },
          "entry_price": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Entry Price"
          },
          "exit_price": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Exit Price"
          },
          "price_capture_id": {
            "type": "string",
            "title": "Price Capture Id"
          },
          "entry_rule": {
            "type": "string",
            "const": "first close strictly after signal date",
            "title": "Entry Rule",
            "default": "first close strictly after signal date"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "signal_date",
          "model_run_id",
          "target",
          "entry_date",
          "exit_date",
          "entry_price",
          "exit_price",
          "price_capture_id"
        ],
        "title": "Outcome"
      },
      "PublicationRequest": {
        "properties": {
          "run_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Run Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "run_id"
        ],
        "title": "PublicationRequest"
      },
      "Query": {
        "properties": {
          "series_id": {
            "type": "string",
            "maxLength": 200,
            "title": "Series Id"
          },
          "start": {
            "type": "string",
            "format": "date",
            "title": "Start"
          },
          "end": {
            "type": "string",
            "format": "date",
            "title": "End"
          },
          "as_of": {
            "type": "string",
            "title": "As Of"
          },
          "basis": {
            "type": "string",
            "enum": [
              "source",
              "platform"
            ],
            "title": "Basis",
            "default": "source"
          },
          "dataset": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dataset"
          },
          "allow_partial": {
            "type": "boolean",
            "title": "Allow Partial",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "series_id",
          "start",
          "end",
          "as_of"
        ],
        "title": "Query"
      },
      "Recipe": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title"
          },
          "queries": {
            "items": {
              "$ref": "#/components/schemas/Query"
            },
            "type": "array",
            "maxItems": 10,
            "minItems": 1,
            "title": "Queries"
          },
          "operation": {
            "type": "string",
            "enum": [
              "level",
              "difference",
              "pct_change",
              "annualized_growth",
              "rolling_mean",
              "zscore",
              "spread",
              "ratio",
              "net_liquidity"
            ],
            "title": "Operation",
            "default": "level"
          },
          "window": {
            "type": "integer",
            "maximum": 520.0,
            "minimum": 1.0,
            "title": "Window",
            "default": 1
          },
          "periods_per_year": {
            "type": "integer",
            "maximum": 366.0,
            "minimum": 1.0,
            "title": "Periods Per Year",
            "default": 4
          },
          "threshold": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Threshold"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "queries"
        ],
        "title": "Recipe"
      },
      "Release": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Id"
          },
          "name": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Name"
          },
          "series_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Series Ids"
          },
          "expected_at": {
            "type": "string",
            "title": "Expected At"
          },
          "observed_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observed At"
          },
          "source_url": {
            "type": "string",
            "title": "Source Url"
          },
          "state": {
            "type": "string",
            "enum": [
              "scheduled",
              "released",
              "cancelled"
            ],
            "title": "State",
            "default": "scheduled"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "series_ids",
          "expected_at",
          "source_url"
        ],
        "title": "Release"
      },
      "RunRequest": {
        "properties": {
          "refresh": {
            "type": "boolean",
            "title": "Refresh",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "RunRequest"
      },
      "Schedule": {
        "properties": {
          "series": {
            "$ref": "#/components/schemas/Series"
          },
          "start": {
            "type": "string",
            "title": "Start"
          },
          "interval_hours": {
            "type": "integer",
            "maximum": 8760.0,
            "minimum": 1.0,
            "title": "Interval Hours",
            "default": 12
          },
          "enabled": {
            "type": "boolean",
            "title": "Enabled",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "series",
          "start"
        ],
        "title": "Schedule"
      },
      "Scope": {
        "properties": {
          "start": {
            "type": "string",
            "format": "date",
            "title": "Start"
          },
          "end": {
            "type": "string",
            "format": "date",
            "title": "End"
          },
          "information_date": {
            "type": "string",
            "format": "date",
            "title": "Information Date"
          },
          "mode": {
            "type": "string",
            "enum": [
              "source_vintage",
              "forward_capture",
              "reconstructed_current_vintage",
              "archive_edition"
            ],
            "title": "Mode"
          },
          "precision": {
            "type": "string",
            "enum": [
              "date",
              "archive_edition",
              "unknown"
            ],
            "title": "Precision",
            "default": "date"
          },
          "complete": {
            "type": "boolean",
            "title": "Complete",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "start",
          "end",
          "information_date",
          "mode"
        ],
        "title": "Scope"
      },
      "Series": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_:./-]+$",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Name"
          },
          "source": {
            "type": "string",
            "enum": [
              "fred",
              "bis",
              "worldbank",
              "nyfed",
              "fixture",
              "legacy"
            ],
            "title": "Source"
          },
          "source_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Source Id"
          },
          "country": {
            "type": "string",
            "maxLength": 20,
            "minLength": 1,
            "title": "Country"
          },
          "unit": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Unit"
          },
          "frequency": {
            "type": "string",
            "enum": [
              "daily",
              "weekly",
              "monthly",
              "quarterly",
              "annual"
            ],
            "title": "Frequency"
          },
          "dimensions": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Dimensions"
          },
          "notes": {
            "type": "string",
            "maxLength": 10000,
            "title": "Notes",
            "default": ""
          },
          "source_url": {
            "type": "string",
            "title": "Source Url",
            "default": ""
          },
          "redistribution": {
            "type": "string",
            "enum": [
              "allowed",
              "personal_only",
              "unreviewed"
            ],
            "title": "Redistribution",
            "default": "unreviewed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "source",
          "source_id",
          "country",
          "unit",
          "frequency"
        ],
        "title": "Series"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "Watchlist": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "series_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Series Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
